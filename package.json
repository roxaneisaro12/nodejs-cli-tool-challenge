{
  "name": "studyflow-cli",
  "version": "1.0.0",
  "description": "A student task management CLI built with Node.js",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "studyflow": "./bin/studyflow.js"
  },
  "scripts": {
    "start": "node bin/studyflow.js",
    "dev": "node --watch bin/studyflow.js",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "student",
    "tasks",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
